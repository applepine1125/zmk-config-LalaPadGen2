config LALAPAD_TP_TUNER
    bool "tp-tuner over BT: GATT service on central, split forwarding to peripheral"
    default y
    depends on INPUT_IQS9151 && ZMK_SPLIT
    help
      Expose the IQS9151 runtime tuning commands over a custom GATT service
      on the central half and forward commands for the peripheral half over
      the ZMK split link (behavior invocation / input-split events).
