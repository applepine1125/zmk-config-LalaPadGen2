config ZMK_INPUT_PROCESSOR_SCROLL_ACCEL
    bool "Scroll acceleration curve input processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_SCROLL_ACCEL_ENABLED
    help
      Apply a speed-dependent gain curve to scroll (wheel) events so that
      slow scrolls stay precise while fast flicks are compressed.

config LALAPAD_TP_TUNER
    bool "tp-tuner over BT: GATT service on central, split forwarding to peripheral"
    default y
    depends on INPUT_IQS9151 && ZMK_SPLIT
    help
      Expose the IQS9151 runtime tuning commands over a custom GATT service
      on the central half and forward commands for the peripheral half over
      the ZMK split link (behavior invocation / input-split events).

config LALAPAD_DIAG_ISR_SAMPLER
    bool "1ms timer sampler for tp stats (CPU halt detection, long coop runs with PC/LR)"
    default n
    depends on LALAPAD_TP_TUNER
    help
      Wakes the CPU every 1ms. Costs battery; enable only while diagnosing.
